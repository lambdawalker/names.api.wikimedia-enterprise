{
  "name": "@lambdawalker/names-api-wikimedia-enterprise",
  "version": "0.1.0",
  "description": "Credential-safe Wikimedia Enterprise article and snapshot research with bounded MCP",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lambdawalker/names.api.wikimedia-enterprise.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "names-wikimedia-enterprise": "dist/cli.js",
    "names-wikimedia-enterprise-mcp": "dist/mcp-stdio.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "config.default.yaml"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "pretest": "npm run build",
    "test": "vitest run",
    "research": "node dist/cli.js",
    "mcp": "node dist/mcp-stdio.js",
    "serve": "node dist/serve.js",
    "mcp:remote": "node dist/mcp-remote.js"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
